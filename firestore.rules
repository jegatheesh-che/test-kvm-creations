rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to verify if the request is from the authorized KVM Studio Admin UID
    function isAdmin() {
      return request.auth != null && request.auth.uid == "D4Etoi6NL0YUX80wtQgO77YlZ1W2";
    }

    // Rules for Gallery Collection
    match /gallery/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Rules for Testimonials / Reviews Collection
    match /testimonials/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /reviews/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Rules for Hero Collection
    match /hero/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Rules for About Collection
    match /about/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Rules for Contact Form Submissions
    match /contacts/{document=**} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Fallback: Deny all other unhandled collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
